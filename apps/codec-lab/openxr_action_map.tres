[gd_resource type="OpenXRActionMap" load_steps=19 format=3]

[sub_resource type="OpenXRAction" id="Aim"]
resource_name = "aim_pose"
localized_name = "Aim Pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="Select"]
resource_name = "select"
localized_name = "Select"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="Reset"]
resource_name = "reset"
localized_name = "Reset"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRActionSet" id="Lab"]
resource_name = "codec_lab"
localized_name = "Codec Lab"
actions = [SubResource("Aim"), SubResource("Select"), SubResource("Reset")]

[sub_resource type="OpenXRIPBinding" id="SimpleleftAim"]
action = SubResource("Aim")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="SimpleleftSelect"]
action = SubResource("Select")
binding_path = "/user/hand/left/input/select/click"

[sub_resource type="OpenXRIPBinding" id="SimpleleftReset"]
action = SubResource("Reset")
binding_path = "/user/hand/left/input/menu/click"

[sub_resource type="OpenXRIPBinding" id="SimplerightAim"]
action = SubResource("Aim")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="SimplerightSelect"]
action = SubResource("Select")
binding_path = "/user/hand/right/input/select/click"

[sub_resource type="OpenXRIPBinding" id="SimplerightReset"]
action = SubResource("Reset")
binding_path = "/user/hand/right/input/menu/click"

[sub_resource type="OpenXRInteractionProfile" id="Simple"]
interaction_profile_path = "/interaction_profiles/khr/simple_controller"
bindings = [SubResource("SimpleleftAim"), SubResource("SimpleleftSelect"), SubResource("SimpleleftReset"), SubResource("SimplerightAim"), SubResource("SimplerightSelect"), SubResource("SimplerightReset")]

[sub_resource type="OpenXRIPBinding" id="TouchleftAim"]
action = SubResource("Aim")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="TouchleftSelect"]
action = SubResource("Select")
binding_path = "/user/hand/left/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="TouchleftReset"]
action = SubResource("Reset")
binding_path = "/user/hand/left/input/y/click"

[sub_resource type="OpenXRIPBinding" id="TouchrightAim"]
action = SubResource("Aim")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="TouchrightSelect"]
action = SubResource("Select")
binding_path = "/user/hand/right/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="TouchrightReset"]
action = SubResource("Reset")
binding_path = "/user/hand/right/input/b/click"

[sub_resource type="OpenXRInteractionProfile" id="Touch"]
interaction_profile_path = "/interaction_profiles/oculus/touch_controller"
bindings = [SubResource("TouchleftAim"), SubResource("TouchleftSelect"), SubResource("TouchleftReset"), SubResource("TouchrightAim"), SubResource("TouchrightSelect"), SubResource("TouchrightReset")]

[resource]
action_sets = [SubResource("Lab")]
interaction_profiles = [SubResource("Simple"), SubResource("Touch")]
