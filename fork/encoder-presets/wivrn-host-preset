#!/usr/bin/env python3
"""Render or save WiVRn Pro encoder presets; never restart services or alter a headset."""
import argparse
import copy
import datetime
import json
import os
from pathlib import Path
import stat
import sys
import tempfile

ROOT = Path(__file__).resolve().parent


def default_config():
    return Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "wivrn-pro/config.json"


def read_object(path, missing_ok=False):
    if missing_ok and not path.exists():
        return {}
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(f"{path}: expected a JSON object")
    return value


def presets():
    return {p.stem: read_object(p) for p in sorted((ROOT / "profiles").glob("*.json"))}


def merge(base, preset):
    result = copy.deepcopy(base)
    # Match the host's top-level replacement merge; replace the entire encoder
    # object to avoid retaining incompatible private options from another codec.
    result.update(copy.deepcopy(preset["host_config"]))
    return result


def atomic_write(path, data, mode):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def client_instructions(preset):
    c = preset["headset_settings"]
    rate = c["bitrate_mbps"]
    bitrate = f"Bitrate {rate} Mbit/s" if rate is not None else "Bitrate slider does not cap CQP output"
    return (f"Headset: {bitrate}; {c['refresh_rate_hz']} Hz; foveated encoding "
            f"{c['foveation_percent']}%; {c['codec']}; 10-bit color off; "
            "low-latency decoding on; Application SpaceWarp off. Keep render resolution unchanged. "
            "Foveation/codec/decoder changes require reconnecting. Host settings apply to a new session.")


def main(argv=None):
    catalog = presets()
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list", help="List profiles and client bitrate requirements")
    show = sub.add_parser("show", help="Show the full profile and headset settings")
    show.add_argument("preset", choices=catalog)
    render = sub.add_parser("render", help="Merge a profile into a reviewable config; no live change")
    render.add_argument("preset", choices=catalog)
    render.add_argument("--base", type=Path, default=default_config())
    render.add_argument("--output", type=Path, help="New output file; defaults to stdout")
    render.add_argument("--cqp-capable", action="store_true", help="Target is the CQP-capable experimental branch")
    apply = sub.add_parser("apply", help="Save host config with a backup; no restart or headset changes")
    apply.add_argument("preset", choices=catalog)
    apply.add_argument("--config", type=Path, default=default_config())
    apply.add_argument("--cqp-capable", action="store_true", help="Target is the CQP-capable experimental branch")
    args = parser.parse_args(argv)
    if args.command == "list":
        for name, preset in catalog.items():
            print(f"{name:25} {preset['title']}")
        print("Bitrate, refresh and foveation require matching headset settings; they are not host config fields.")
        return 0
    preset = catalog[args.preset]
    if args.command == "show":
        print(json.dumps(preset, indent=2))
        return 0
    if preset["requires_cqp_branch"] and not args.cqp_capable:
        parser.error("CQP requires the experimental CQP branch. Pass --cqp-capable only for that target; stock builds ignore these options.")
    target = args.config if args.command == "apply" else args.base
    if target.is_symlink():
        raise ValueError(f"Refusing a symlink config: {target}")
    # Invalid existing JSON must not be replaced by an empty configuration.
    base = read_object(target, missing_ok=True)
    output = json.dumps(merge(base, preset), indent=2) + "\n"
    if args.command == "render":
        if args.output:
            if args.output.resolve() in (target.resolve(), default_config().resolve()):
                raise ValueError("render output must be separate from the base and active config; use apply to save a config")
            # Review outputs are create-only to prevent inadvertent overwrites.
            args.output.parent.mkdir(parents=True, exist_ok=True)
            with args.output.open("x") as stream:
                stream.write(output)
            print(f"Rendered {args.output}")
        else:
            sys.stdout.write(output)
    else:
        mode = stat.S_IMODE(target.stat().st_mode) if target.exists() else 0o600
        if target.exists():
            suffix = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
            backup = target.with_name(target.name + ".before-" + args.preset + "-" + suffix)
            with backup.open("xb") as stream:
                os.fchmod(stream.fileno(), mode)
                stream.write(target.read_bytes())
            print(f"Backup: {backup}")
        atomic_write(target, output, mode)
        print(f"Saved host settings to {target}; no service restarted and no headset settings changed.")
    print(client_instructions(preset), file=sys.stderr)
    if any(key in base for key in ("bitrate", "scale", "encoders")):
        print("Preserved legacy bitrate/scale/encoders keys; this WiVRn Pro parser ignores them.", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"Error: {error}", file=sys.stderr)
        sys.exit(1)
