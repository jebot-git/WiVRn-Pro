#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D y;
layout(set = 0, binding = 1) uniform sampler2D cb;
layout(set = 0, binding = 2) uniform sampler2D cr;
layout(set = 0, binding = 3, rgba8) writeonly uniform image2D rgba;
void main() {
    // Each source texel contains one 2x2 pixel quad. Fetch its three packed
    // planes once and convert all four pixels in the same invocation.
    ivec2 quad = ivec2(gl_GlobalInvocationID.xy);
    ivec2 p = quad * 2;
    ivec2 size = imageSize(rgba);
    if (any(greaterThanEqual(p, size))) return;
    vec4 l = texelFetch(y, quad, 0);
    vec4 b = texelFetch(cb, quad, 0) - 0.5;
    vec4 r = texelFetch(cr, quad, 0) - 0.5;
    // Full-range BT.709, with full-resolution chroma. Reprojection performs the sRGB EOTF.
    vec4 red = clamp(l + 1.5748*r, 0.0, 1.0);
    vec4 green = clamp(l - 0.187324*b - 0.468124*r, 0.0, 1.0);
    vec4 blue = clamp(l + 1.8556*b, 0.0, 1.0);
    imageStore(rgba, p, vec4(red.x, green.x, blue.x, 1));
    if (p.x + 1 < size.x)
        imageStore(rgba, p + ivec2(1, 0), vec4(red.y, green.y, blue.y, 1));
    if (p.y + 1 < size.y) {
        imageStore(rgba, p + ivec2(0, 1), vec4(red.z, green.z, blue.z, 1));
        if (p.x + 1 < size.x)
            imageStore(rgba, p + ivec2(1, 1), vec4(red.w, green.w, blue.w, 1));
    }
}
