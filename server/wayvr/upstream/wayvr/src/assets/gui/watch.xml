<layout version="2">
  <vars>
    <var key="clock0_size" value="40" />
    <var key="clock0_date_size" value="16" />
    <var key="clock0_dow_size" value="16" />
    <var key="clock_alt_size" value="24" />
    <var key="clock_alt_tz_size" value="14" />
  </vars>

  <macro name="decorative_rect"
    padding="8" color="background"
    border="2" border_color="outline" round="8" />

  <macro name="button_style" padding="8" border="2" round="8" align_items="center" justify_content="center" />

  <template name="TrackingControls">
    <div id="fan_controls" position="absolute" width="1000" height="760" interactable="0" />
  </template>

  <template name="FanButton">
    <Button id="${id}" position="absolute" margin_left="${x}" margin_top="${y}"
      width="128" height="128" padding="10" border="2" round="22"
      flex_direction="column" gap="8" align_items="center" justify_content="center"
      color="background_variant" border_color="outline" hover_color="primary" hover_border_color="primary"
      sticky_color="background" sticky_border_color="primary" tooltip_str="${title}" tooltip_side="top">
      <sprite src_builtin="@/${icon}" width="52" height="52" />
      <label text="${title}" size="18" weight="bold" align="center" wrap="1" width="104" />
    </Button>
  </template>

  <template name="Device">
    <rectangle id="battery_${idx}" macro="decorative_rect" padding="4" padding_top="2" padding_bottom="2" border="1" align_items="center" gap="4">
      <sprite width="20" height="20" src_builtin="${src}" color="on_background" />
      <label _source="battery" _device="${idx}" size="16" weight="bold" _low_color="danger" _normal_color="primary" _charging_color="tertiary" />
    </rectangle>
  </template>

  <template name="Hmd">
    <Device idx="${idx}" src="@/watch/hmd.svg" />
  </template>
  <template name="LeftHand">
    <Device idx="${idx}" src="@/watch/controller_l.svg" />
  </template>
  <template name="RightHand">
    <Device idx="${idx}" src="@/watch/controller_r.svg" />
  </template>
  <template name="Tracker">
    <Device idx="${idx}" src="@/watch/track.svg" />
  </template>

  <template name="ShoraTracker">
    <rectangle macro="decorative_rect" padding="4" padding_top="2" padding_bottom="2" border="1" align_items="center" gap="4">
      <sprite width="20" height="20" src_builtin="@/watch/track.svg" color="on_background" />
      <label _source="shora_battery" _device="${key}" size="16" weight="bold" _low_color="danger" _normal_color="primary" />
    </rectangle>
  </template>

  <template name="Screen">
    <Button macro="button_style" id="overlay_${idx}" tooltip_str="${name}" _press="::OverlayToggle ${name}">
      <sprite width="38" height="38" src_builtin="@/edit/screen.svg" />
      <div position="absolute" margin_top="-7" margin_left="-1">
        <label text="${display}" size="18" weight="bold" parent_color="background" />
      </div>
    </Button>
  </template>
  <template name="Panel">
    <Button macro="button_style" id="overlay_${idx}" tooltip_str="${name}" _press="::OverlayToggle ${name}">
      <sprite width="38" height="38" src_builtin="@/edit/panel.svg" />
    </Button>
  </template>
  <template name="Mirror">
    <Button macro="button_style" id="overlay_${idx}" tooltip_str="${name}" _press="::OverlayToggle ${name}">
      <sprite width="38" height="38" src_builtin="@/edit/mirror.svg" />
      <div position="absolute" margin_top="5" margin_left="13">
        <label text="${display}" size="20" weight="bold" parent_color="background" />
      </div>
    </Button>
  </template>
  <template name="Passthru">
    <Button macro="button_style" id="overlay_${idx}" tooltip_str="${name}" _press="::OverlayToggle ${name}">
      <sprite width="38" height="38" src_builtin="@/icons/landscape.svg" />
      <div position="absolute" margin_top="5" margin_left="13">
        <label text="${display}" size="20" weight="bold" parent_color="background" />
      </div>
    </Button>
  </template>
  <template name="App">
    <Button macro="button_style" id="overlay_${idx}" tooltip_str="${name}" _press="::OverlayToggle ${name}">  
      <sprite width="38" height="38" src_ext="${icon}" />
    </Button>
  </template>
    
  <template name="Set">
    <Button macro="button_style" id="set_${idx}" _press="::SetToggle ${idx}" tooltip="WATCH.SWITCH_TO_SET" tooltip_side="top">
      <sprite width="38" height="38" src_builtin="@/watch/set2.svg" />
      <div position="absolute" margin_top="9">
        <label text="${display}" size="24" weight="bold" parent_color="background" />
      </div>
    </Button>
  </template>

  <template name="Clock">
    <div gap="8" flex_direction="column" padding="0">
      <div flex_direction="column" >
        <label text="11:22 PM" _source="clock" _display="time" color="on_background" size="~clock0_size" weight="bold" align="right" width="100%" />
        <div padding_left="0" gap="8" flex_direction="row" justify_content="end">
          <label text="Tue" _source="clock" _display="dow_short" color="on_background_variant" size="~clock0_dow_size" weight="bold" />
          <label text="22/2/2022" _source="clock" _display="date" color="on_background_variant" size="~clock0_date_size" weight="bold" />
        </div>
      </div>
      <div flex_direction="row" gap="8" justify_content="space_around">
        <!-- Timezone names here are only placeholders. Set your timezones via ~/.config/wayvr/conf.d -->
        <div flex_direction="column">
          <label text="Paris" _source="clock" _display="name" _timezone="0" color="secondary" size="~clock_alt_tz_size" weight="bold" align="center" />
          <label text="23:59" _source="clock" _display="time" _timezone="0" color="secondary" size="~clock_alt_size" weight="bold" align="center" />
        </div>
        <div flex_direction="column">
          <label text="New York" _source="clock" _display="name" _timezone="1" color="tertiary" size="~clock_alt_tz_size" weight="bold" align="center" />
          <label text="23:59" _source="clock" _display="time" _timezone="1" color="tertiary" size="~clock_alt_size" weight="bold" align="center" />
        </div>
      </div>
    </div>
  </template>

  <template name="VerticalSeparator">
    <rectangle width="2" height="100%" color="outline" />
  </template>

  <elements>
    <!-- Fixed transparent canvas keeps physical button size/position unchanged on expansion. -->
    <div width="1000" height="760" interactable="0">
      <div id="watch_base" position="absolute" width="1000" height="760" interactable="0">
        <rectangle id="watch_body" position="absolute" margin_left="48" margin_top="500" width="628" height="180"
          color="background" border="2" border_color="outline" round="28" interactable="0" />
        <div id="devices_root" position="absolute" margin_left="64" margin_top="396"
          interactable="0" gap="4" height="96" overflow="hidden" width="596" max_width="596" flex_direction="row" flex_wrap="wrap" align_content="end">
          <Hmd idx="0" /><LeftHand idx="1" /><RightHand idx="2" /><Tracker idx="3" />
        </div>
        <div id="clock_root" position="absolute" margin_left="64" margin_top="508" width="180"><Clock /></div>
        <label id="tracking_reset_status" position="absolute" margin_left="64" margin_top="652"
          _source="watch_status" size="12" width="596" height="20" wrap="0" overflow="hidden" color="on_background" />
        <div id="sets_root" position="absolute" margin_left="48" margin_top="688" gap="8">
          <Set idx="0" display="1" /><Set idx="1" display="2" />
        </div>
        <div id="panels_root" position="absolute" margin_left="48" margin_top="688" gap="8" display="none">
          <Screen idx="0" display="H1" name="HDMI-A-1" /><Screen idx="1" display="D2" name="DP-2" />
        </div>
      </div>
      <div id="fan_heading" position="absolute" margin_left="48" margin_top="116" display="none"
        width="904" flex_direction="column" gap="8" interactable="0">
        <label id="fan_title" text="Calibration" size="32" weight="bold" align="center" />
        <label text="Choose an action · tap the group again to close" size="18" align="center" color="on_background_variant" />
      </div>
      <div id="interaction_buttons" position="absolute" width="1000" height="760" interactable="0">
        <TrackingControls />
      </div>
    </div>
  </elements>
</layout>
