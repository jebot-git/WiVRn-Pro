[Unit]
Description=WiVRn Pro (Quest Pro, Intel Arc, spatial capture, Shora tracking and WayVR)
After=graphical-session.target
PartOf=graphical-session.target
Conflicts=wayvr.service wlx-overlay-s.service wivrn.service wivrn-pro-shora.service shora-server.service shora-proxy.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/wivrn-pro-server
Environment=XDG_RUNTIME_DIR=%t
RuntimeDirectory=wivrn-pro
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=default.target
