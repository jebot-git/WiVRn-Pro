# Generated by install_service.py; runs from the selected checkout.
[Unit]
Description=Spatial bridge for WiVRn and local PC clients
After=wivrn.service

[Service]
Type=exec
ExecStart=@EXEC_START@
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=mixed
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target wivrn.service
