#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0) uniform sampler2D source_image;
layout(set=0,binding=1,std430) writeonly buffer Linear { vec4 pixels[]; };
layout(push_constant) uniform Params { uint width,height,mode,count; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.width*pc.height)return;
    ivec2 p=ivec2(i%pc.width,i/pc.width);
    if(pc.mode==0) pixels[i]=texelFetch(source_image,p,0);
    else {
        vec2 offset=pc.mode==1?vec2(.5):vec2(.25,.75);
        pixels[i]=textureLod(source_image,(vec2(p)+offset)/vec2(pc.width,pc.height),0.0);
    }
}
