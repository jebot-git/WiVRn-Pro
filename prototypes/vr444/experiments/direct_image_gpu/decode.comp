#version 450
// Isolated direct-image experiment, derived from constant_fastpath/constant_decode.comp.
// Integer arithmetic, no subgroup, FP16 or video extensions.
// One workgroup per tile. 6144 bytes shared, no subgroup requirements.
#ifndef WORKGROUP
#define WORKGROUP 64
#endif
layout(local_size_x=WORKGROUP) in;
layout(set=0,binding=0,std430) readonly buffer Input { uint rgba[]; };
layout(set=0,binding=1,std430) coherent buffer Stream { uint slots[]; };
layout(set=0,binding=2,std430) buffer Lengths { uint lengths[]; };
#if defined(OUTPUT_UNORM)
layout(set=0,binding=3,rgba8) writeonly uniform image2D output_image;
#elif defined(OUTPUT_UINT)
layout(set=0,binding=3,rgba8ui) writeonly uniform uimage2D output_image;
#else
layout(set=0,binding=3,std430) writeonly buffer Output { uint result[]; };
#endif
layout(set=0,binding=4,std430) readonly buffer Quantizers { uint tile_q[]; };
layout(push_constant) uniform Params { uint width,height,q,count; } pc;
const uint STRIDE=320;
shared int v[768];
shared int scratch[768];
uint tile,bitpos;
int half_floor(int x) { return x>=0 ? x/2 : -((-x+1)/2); }
uint zigzag(int x) { return x>=0 ? uint(x*2) : uint(-2*x-1); }
int unzigzag(uint x) { return (x&1)!=0 ? -int((x+1)/2) : int(x/2); }
// Same LSB-first wire format, word accesses instead of one SSBO access per bit.
void put_bits(uint value,uint n) {
    uint word=bitpos/32,shift=bitpos%32;
    value &= (1u<<n)-1;
    slots[tile*STRIDE+word] |= value<<shift;
    if(shift+n>32)slots[tile*STRIDE+word+1] |= value>>(32-shift);
    bitpos+=n;
}
uint get_bits(uint n) {
    uint word=bitpos/32,shift=bitpos%32,limit=min(lengths[tile],STRIDE);
    uint value=word<limit?slots[tile*STRIDE+word]>>shift:0;
    if(shift+n>32 && word+1<limit)value |= slots[tile*STRIDE+word+1]<<(32-shift);
    bitpos+=n;
    return value&((1u<<n)-1);
}
void transform_all(bool inverse) {
    uint lane=gl_LocalInvocationID.x;
    for(int n=inverse?2:16; inverse?n<=16:n>=2; n=inverse?n*2:n/2) {
        for(int axis=0;axis<2;axis++) {
            bool col=inverse ? axis==0 : axis==1;
            uint pairs=uint(n*n/2);
            for(uint job=lane;job<3*pairs;job+=WORKGROUP) {
                int c=int(job/pairs),line=int(job%pairs)/ (n/2),i=int(job%pairs)%(n/2);
                if(!inverse) {
                    int p=c*256+(col?2*i*16+line:line*16+2*i);
                    int b=v[p+(col?16:1)],d=v[p]-b;
                    int outp=c*256+(col?i*16+line:line*16+i);
                    scratch[outp]=b+half_floor(d);scratch[outp+(col?n*8:n/2)]=d;
                } else {
                    int p=c*256+(col?i*16+line:line*16+i);
                    int d=v[p+(col?n*8:n/2)],b=v[p]-half_floor(d);
                    int outp=c*256+(col?2*i*16+line:line*16+2*i);
                    scratch[outp]=b+d;scratch[outp+(col?16:1)]=b;
                }
            }
            barrier();
            for(uint job=lane;job<uint(3*n*n);job+=WORKGROUP) {
                int c=int(job)/ (n*n),i=int(job)%(n*n),p=c*256+(i/n)*16+i%n;
                v[p]=scratch[p];
            }
            barrier();
        }
    }
}
void store_pixel(uint x,uint y,uint p) {
#if defined(OUTPUT_UNORM)
    imageStore(output_image,ivec2(x,y),vec4(p&255u,(p>>8)&255u,(p>>16)&255u,255u)/255.0);
#elif defined(OUTPUT_UINT)
    imageStore(output_image,ivec2(x,y),uvec4(p&255u,(p>>8)&255u,(p>>16)&255u,255u));
#else
    result[y*pc.width+x]=p;
#endif
}
void main() {
    tile=gl_WorkGroupID.x;if(tile>=pc.count)return;bitpos=0;
    uint lane=gl_LocalInvocationID.x,nx=(pc.width+15)/16,bx=(tile%nx)*16,by=(tile/nx)*16;

    // All lanes read the same immutable three words. The branch is uniform for
    // the whole workgroup; no invocation skips a barrier reached by its peers.
    // A canonical DC-only tile is 3 * (11 DC + 16 zero AC flags) = 81 bits.
    // Test all AC flag and padding bits, not only the three-word length (small
    // non-constant tiles may also fit in three words).
    if(lengths[tile]==3u) {
        uint a=slots[tile*STRIDE],bword=slots[tile*STRIDE+1],cword=slots[tile*STRIDE+2];
        if((a & ~0xf80007ffu)==0u && (bword & ~0xffc0003fu)==0u && (cword & ~1u)==0u) {
            int yy=unzigzag(a&2047u);
            int co=unzigzag(((a>>27)|(bword<<5))&2047u);
            int cg=unzigzag(((bword>>22)|(cword<<10))&2047u);
            int t=yy-half_floor(cg),g=cg+t,b=t-half_floor(co),r=b+co;
            uint pixel=uint(clamp(r,0,255))|(uint(clamp(g,0,255))<<8)|(uint(clamp(b,0,255))<<16)|0xff000000u;
            for(uint i=lane;i<256;i+=WORKGROUP) {
                uint x=i%16,y=i/16;
                if(bx+x<pc.width && by+y<pc.height)store_pixel(bx+x,by+y,pixel);
            }
            return;
        }
    }
    if(lane==0) {
    for(uint i=0;i<768;i++)v[i]=0;
    for(uint c=0;c<3;c++) {
        v[c*256]=unzigzag(get_bits(11));
        for(uint base=1;base<256;base+=16)if(get_bits(1)!=0){
            uint n=get_bits(4),mode=get_bits(2),repeated=mode==0?get_bits(n):0,mask=mode==2?get_bits(16):0xffff;
            for(uint i=base;i<min(base+16,256);i++){uint a=mode==0?repeated:(((mask&(1u<<(i-base)))!=0)?get_bits(n):0);v[c*256+i]=unzigzag(a)*int(tile_q[tile]);}
        }

    }
    }
    barrier();transform_all(true);
    for(uint i=lane;i<256;i+=WORKGROUP) {
        uint x=i%16,y=i/16;if(bx+x>=pc.width || by+y>=pc.height)continue;
        int t=v[i]-half_floor(v[512+i]),g=v[512+i]+t,b=t-half_floor(v[256+i]),r=b+v[256+i];
        store_pixel(bx+x,by+y,uint(clamp(r,0,255))|(uint(clamp(g,0,255))<<8)|(uint(clamp(b,0,255))<<16)|0xff000000u);
    }

}
