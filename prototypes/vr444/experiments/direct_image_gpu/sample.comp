#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0) uniform sampler2D source_image;
layout(set=0,binding=1,std430) writeonly buffer Linear { vec4 pixels[]; };
layout(push_constant) uniform Params { uint width,height,q,count; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.width*pc.height)return;
    pixels[i]=texelFetch(source_image,ivec2(i%pc.width,i/pc.width),0);
}
