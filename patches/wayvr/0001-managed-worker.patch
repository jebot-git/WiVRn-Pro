+        for letter in 'A'..='Z' {
+            assert_eq!(
+                layout
+                    .main_layout
+                    .iter()
+                    .flatten()
+                    .filter(|k| k.as_deref() == Some(&letter.to_string()))
+                    .count(),
+                1
+            );
+        }
+        for key in ["Space", "Return", "BackSpace", "LShift", "KEYMAP_CYCLE"] {
+            assert!(
+                layout
+                    .main_layout
+                    .iter()
+                    .flatten()
+                    .any(|k| k.as_deref() == Some(key))
+            );
+        }
+        assert_eq!(base.row_size, 23.);
+    }
+}
