+    let normal = transform.z_axis.try_normalize()?;
+    let origin = Affine3A::from_rotation_translation(rotation, (tip + normal * 0.05).into());
+    let hit = ray_test(&origin, id, transform, curvature)?;
+    let clearance = hit.dist - 0.05;
