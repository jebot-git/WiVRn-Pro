diff --git a/common/codec_test/compression/README.txt b/common/codec_test/compression/README.txt
new file mode 100644
index 0000000..53c72b1
--- /dev/null
+++ b/common/codec_test/compression/README.txt
@@ -0,0 +1,41 @@
+WiVRn CODEC TEST frame compression, development 0.11
+
+frame_compression.h exposes an explicitly configured, stateless WPC1 admission
+layer. Link vendor/lz4.c as C. All wrappers require C++20. Header-only functions
+are namespace wivrn::codec_test::compression; no dependency beyond libc/libstdc++
+and this vendor LZ4 source. Android/Linux aarch64 builds dispatch CRC through
+HWCAP_CRC32 to target("crc") IEEE hardware CRC; other builds use the table path.
+
+Selection select(span<const uint8_t> raw, Workspace&, size_t minimum_saving_bytes=64)
+returns payload, attempted, compressed, original_bytes, wire_bytes. The returned
+payload is either a complete method-1 WPC1 frame or the original input span. It
+never increases selected payload size, even with minimum_saving_bytes=0. Inputs
+of 16 MiB-23 through 16 MiB bytes bypass compression (the legacy WPC1 raw escape
+must fit its 24-byte header). Inputs must be nonempty and at most 16 MiB. Tiny
+inputs and impossible saving thresholds bypass the attempt. Raw fallback has
+compressed=false and NO WPC1 header. Select only updates compression metadata;
+it supplies no frame identity, authentication, negotiation or transport change.
+
+span<const uint8_t> decode(span<const uint8_t> wrapped, Workspace&) validates
+method-1 compressed WPC1 (strictly shorter than its claimed decoded size), all
+framing before output allocation, LZ4 exact output size, then IEEE CRC32 before
+returning. Any failure throws std::runtime_error and clears decoded size. A
+receiver MUST NOT invoke its codec decoder after an exception. Method-0 WPC1 raw
+escapes are rejected: callers send raw with no compression flag instead. WPC1
+input_limit is 16 MiB minus 24; compressed wire limit is 16 MiB. CRC detects
+accidental corruption; it is not authentication against an active attacker.
+
+Use separate encoder and decoder Workspace instances per simultaneous operation.
+Views borrow storage and expire on the next workspace mutation/destruction; raw
+selection views borrow caller input. Every input overlapping any allocated
+workspace buffer is rejected, even when current vector size has shrunk. Returned
+views may be copied to independent storage for later reuse. The helper retains
+vector capacity after warmup but resets frame/block state for each call. There
+are no cross-frame dictionaries or dependencies. Scratch capacity is at most
+LZ4_compressBound(16 MiB-24), slightly above 16 MiB; input/output bounds remain
+16 MiB. Allocation failure propagates without admitting a result.
+
+WPC1 source derives from prototypes/vr444/experiments/native_lz4/wpc.hpp (MIT),
+with namespace and automatic runtime ARM CRC guard adjustments. Header/block
+encoding is unchanged; whole-frame profile uses block size 16 MiB. The pinned
+vendor directory preserves LZ4 v1.10.0, BSD-2-Clause license and source hashes.
diff --git a/common/codec_test/compression/frame_compression.h b/common/codec_test/compression/frame_compression.h
new file mode 100644
index 0000000..aacd97c
--- /dev/null
+++ b/common/codec_test/compression/frame_compression.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "wpc1.h"
+
+namespace wivrn::codec_test::compression {
+inline constexpr size_t max_payload_bytes = 16u * 1024 * 1024;
+inline constexpr size_t default_minimum_saving_bytes = 64;
+
+struct Selection {
+    std::span<const uint8_t> payload;
+    bool attempted;
+    bool compressed;
+    size_t original_bytes;
+    size_t wire_bytes;
+};
+
+// One workspace per concurrent operation. Views returned by select/decode borrow
+// storage and expire when this workspace is next mutated or destroyed. A raw
+// selection instead borrows its caller's input. No state crosses frame boundaries.
+class Workspace {
+    detail::Workspace buffers;
+    static bool aliases(std::span<const uint8_t> input, const detail::Bytes& buffer) {
+        if (input.empty() || buffer.capacity() == 0) return false;
+        const auto a = reinterpret_cast<uintptr_t>(input.data());
+        const auto b = reinterpret_cast<uintptr_t>(buffer.data());
+        return a <= b ? b - a < input.size() : a - b < buffer.capacity();
+    }
+    bool aliases(std::span<const uint8_t> input) const {
+        return aliases(input, buffers.wire) || aliases(input, buffers.scratch) || aliases(input, buffers.decoded);
+    }
+    friend Selection select(std::span<const uint8_t>, Workspace&, size_t);
+    friend std::span<const uint8_t> decode(std::span<const uint8_t>, Workspace&);
+};
+
+// Call only under an explicit test configuration. A false compressed result is
+// the original unwrapped payload: never mark it compressed in the outer envelope.
+// Inputs at the 16 MiB envelope limit that cannot fit a WPC1 raw escape are passed
+// through without attempting compression. minimum_saving_bytes cannot force growth.
+inline Selection select(std::span<const uint8_t> raw, Workspace& workspace,
+                        size_t minimum_saving_bytes = default_minimum_saving_bytes) {
+    detail::require(!raw.empty() && raw.size() <= max_payload_bytes);
+    detail::require(!workspace.aliases(raw));
+    Selection result{raw, false, false, raw.size(), raw.size()};
+    if (raw.size() > detail::input_limit || raw.size() <= 36 ||
+        minimum_saving_bytes >= raw.size() || raw.size() - minimum_saving_bytes <= 36)
+        return result;
+    result.attempted = true;
+    detail::encode(raw, detail::wire_limit, workspace.buffers);
+    const auto& wire = workspace.buffers.wire;
+    if (wire[5] == 1 && wire.size() < raw.size() &&
+        raw.size() - wire.size() >= minimum_saving_bytes) {
+        result.payload = wire;
+        result.compressed = true;
+        result.wire_bytes = wire.size();
+    }
+    return result;
+}
+
+// Return only after exact bounded decompression and the uncompressed CRC pass.
+// The caller must not invoke the codec decoder if this function throws. CRC is
+// corruption detection, not authentication. The outer envelope supplies identity.
+inline std::span<const uint8_t> decode(std::span<const uint8_t> wrapped, Workspace& workspace) {
+    detail::require(!workspace.aliases(wrapped));
+    workspace.buffers.decoded.clear();
+    try {
+        detail::require(wrapped.size() > 24 && wrapped.size() <= max_payload_bytes);
+        detail::require(wrapped[5] == 1 && wrapped.size() < detail::u32(wrapped, 8));
+        detail::decode(wrapped, workspace.buffers);
+        return workspace.buffers.decoded;
+    } catch (...) {
+        workspace.buffers.decoded.clear();
+        throw;
+    }
+}
+inline bool hardware_crc_enabled() { return detail::arm_crc_enabled(); }
+} // namespace wivrn::codec_test::compression
