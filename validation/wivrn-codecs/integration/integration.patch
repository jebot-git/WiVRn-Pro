diff --git a/common/codec_test/compression/wpc1.h b/common/codec_test/compression/wpc1.h
new file mode 100644
index 0000000..87459c3
--- /dev/null
+++ b/common/codec_test/compression/wpc1.h
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "vendor/lz4.h"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <span>
+#include <stdexcept>
+#include <vector>
+#if defined(__aarch64__) && (defined(__linux__) || defined(__ANDROID__))
+#include <arm_acle.h>
+#include <sys/auxv.h>
+#include <asm/hwcap.h>
+#endif
+
+namespace wivrn::codec_test::compression::detail {
+using Bytes = std::vector<uint8_t>;
+using View = std::span<const uint8_t>;
+constexpr uint32_t wire_limit = 16u * 1024 * 1024;
+constexpr uint32_t input_limit = wire_limit - 24;
+inline void require(bool b) { if (!b) throw std::runtime_error("invalid WPC1 input"); }
+inline uint32_t u32(View b, size_t p) {
+    require(p <= b.size() && b.size()-p >= 4);
+    return uint32_t(b[p]) | uint32_t(b[p+1])<<8 | uint32_t(b[p+2])<<16 | uint32_t(b[p+3])<<24;
+}
+inline void put(Bytes &b, uint32_t v) { for (unsigned i=0;i<4;++i) b.push_back(uint8_t(v>>(8*i))); }
+inline uint32_t crc_table(View b) {
+    static const auto table = [] {
+        std::array<uint32_t,256> t{};
+        for(uint32_t i=0;i<256;++i) { uint32_t c=i; for(int k=0;k<8;++k) c=(c>>1)^((c&1)?0xedb88320u:0); t[i]=c; }
+        return t;
+    }();
+    uint32_t c=~0u;
+    for(auto v:b) c=table[(c^v)&255]^(c>>8);
+    return ~c;
+}
+#if defined(__aarch64__) && (defined(__linux__) || defined(__ANDROID__))
+__attribute__((target("crc"))) inline uint32_t crc_arm(View b) {
+    uint32_t c=~0u; size_t p=0;
+    for(;b.size()-p>=8;p+=8) { uint64_t word; std::memcpy(&word,b.data()+p,8); c=__crc32d(c,word); }
+    for(;p<b.size();++p)c=__crc32b(c,b[p]);
+    return ~c;
+}
+inline bool arm_crc_enabled() { static bool enabled=(getauxval(AT_HWCAP)&HWCAP_CRC32)!=0; return enabled; }
+#else
+inline bool arm_crc_enabled() { return false; }
+#endif
+inline uint32_t crc(View b) {
+#if defined(__aarch64__) && (defined(__linux__) || defined(__ANDROID__))
+    if(arm_crc_enabled())return crc_arm(b);
+#endif
+    return crc_table(b);
+}
+struct Workspace { Bytes wire, scratch, decoded; };
+inline bool overlaps(View a, View b) {
+    if(a.empty()||b.empty())return false;
+    auto x=reinterpret_cast<uintptr_t>(a.data()),y=reinterpret_cast<uintptr_t>(b.data());
+    return x<=y?y-x<a.size():x-y<b.size();
+}
+inline void header(Bytes &b, uint8_t method, uint32_t n, uint32_t block, uint32_t count, uint32_t checksum) {
+    b.clear(); b.insert(b.end(), {'W','P','C','1',1,method,0,0});
+    put(b,n); put(b,block); put(b,count); put(b,checksum);
+}
+// Reuses capacities after warmup. Allocation, framing, copies and CRC are included.
+inline void encode(View raw, uint32_t block, Workspace &w) {
+    require(!raw.empty() && raw.size()<=input_limit && block>=256 && block<=wire_limit);
+    require(!overlaps(raw,w.wire)&&!overlaps(raw,w.scratch));
+    auto checksum=crc(raw);
+    header(w.wire,1,uint32_t(raw.size()),block,uint32_t((raw.size()+block-1)/block),checksum);
+    w.scratch.resize(LZ4_compressBound(int(std::min<size_t>(raw.size(),block))));
+    for(size_t at=0; at<raw.size();) {
+        auto n=uint32_t(std::min<size_t>(block,raw.size()-at));
+        int packed=LZ4_compress_default(reinterpret_cast<const char*>(raw.data()+at),reinterpret_cast<char*>(w.scratch.data()),int(n),int(w.scratch.size()));
+        require(packed>0);
+        bool compressed=uint32_t(packed)<n;
+        uint32_t stored=compressed?uint32_t(packed):n;
+        // Stop as soon as the accumulated framing cannot beat the whole raw frame.
+        if (w.wire.size()+12+stored >= raw.size()+24) {
+            header(w.wire,0,uint32_t(raw.size()),0,0,checksum);
+            w.wire.insert(w.wire.end(),raw.begin(),raw.end()); return;
+        }
+        put(w.wire,compressed?1:0); put(w.wire,n); put(w.wire,stored);
+        auto p=compressed?w.scratch.data():raw.data()+at;
+        w.wire.insert(w.wire.end(),p,p+stored); at+=n;
+    }
+    require(w.wire.size()<=wire_limit);
+}
+inline void decode(View b, Workspace &w) {
+    require(b.size()>24 && b.size()<=wire_limit);
+    require(!overlaps(b,w.decoded));
+    require(b[0]=='W'&&b[1]=='P'&&b[2]=='C'&&b[3]=='1'&&b[4]==1&&b[6]==0&&b[7]==0);
+    uint32_t method=b[5], n=u32(b,8), block=u32(b,12), count=u32(b,16), checksum=u32(b,20);
+    require(n>0 && n<=input_limit && method<=1);
+    if(method==0) {
+        require(block==0 && count==0 && b.size()==24+n);
+        w.decoded.assign(b.begin()+24,b.end());
+    } else {
+        require(block>=256 && block<=wire_limit && count==(uint64_t(n)+block-1)/block);
+        // Full framing validation before resizing output or invoking LZ4.
+        size_t at=24; uint32_t left=n;
+        for(uint32_t i=0;i<count;++i) {
+            require(at<=b.size() && b.size()-at>=12);
+            auto flags=u32(b,at), raw=u32(b,at+4), stored=u32(b,at+8); at+=12;
+            require(flags<=1 && raw==std::min(block,left) && stored>0 && stored<=raw);
+            require(flags || stored==raw);
+            require(stored<=b.size()-at); at+=stored; left-=raw;
+        }
+        require(left==0 && at==b.size());
+        w.decoded.resize(n); at=24; size_t out=0;
+        for(uint32_t i=0;i<count;++i) {
+            auto flags=u32(b,at), raw=u32(b,at+4), stored=u32(b,at+8); at+=12;
+            if(flags) {
+                auto got=LZ4_decompress_safe(reinterpret_cast<const char*>(b.data()+at),reinterpret_cast<char*>(w.decoded.data()+out),int(stored),int(raw));
+                require(got==int(raw));
+            } else std::memcpy(w.decoded.data()+out,b.data()+at,raw);
+            at+=stored; out+=raw;
+        }
+    }
+    require(crc(w.decoded)==checksum);
+}
+}
diff --git a/common/codec_test/gaze_timing.h b/common/codec_test/gaze_timing.h
new file mode 100644
index 0000000..ddd502a
--- /dev/null
+++ b/common/codec_test/gaze_timing.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace wivrn::codec_test {
+// All times are in the local OpenXR clock domain. The returned EXT time is
+// pose-expression time, possibly predicted/interpolated; never sensor capture time.
+struct gaze_timing_sample {
+    int64_t scheduled_poll_xr_ns = 0;
+    int64_t poll_begin_xr_ns = 0;
+    int64_t poll_end_xr_ns = 0;
+    int64_t requested_pose_xr_ns = 0;
+    int64_t returned_pose_expression_xr_ns = 0;
+    int32_t locate_result = -1;
+    uint64_t location_flags = 0;
+
+    bool locate_succeeded() const { return locate_result >= 0; }
+    bool time_available() const { return locate_succeeded() && returned_pose_expression_xr_ns != 0; }
+    bool expression_after_poll() const {
+        return time_available() && returned_pose_expression_xr_ns > poll_end_xr_ns;
+    }
+    // OpenXR XrSpaceLocationFlagBits, kept here without a runtime dependency.
+    bool orientation_valid() const { return locate_succeeded() && (location_flags & 1); }
+    bool position_valid() const { return locate_succeeded() && (location_flags & 2); }
+    bool orientation_tracked() const { return locate_succeeded() && (location_flags & 4); }
+    bool position_tracked() const { return locate_succeeded() && (location_flags & 8); }
+    bool poll_order_valid() const { return poll_end_xr_ns >= poll_begin_xr_ns; }
+};
+
+// One instance per stream. Count every instrumented locate, publish a bounded
+// subset. No extrapolation, freshness inference or acquisition-age calculation.
+struct gaze_timing_limiter {
+    static constexpr int64_t interval_ns = 100'000'000;
+    static constexpr size_t max_rows = 6000;
+    uint64_t sequence = 0;
+    size_t rows = 0;
+    int64_t last_emit_xr_ns = 0;
+
+    bool observe(int64_t poll_begin_xr_ns) {
+        if (sequence == std::numeric_limits<uint64_t>::max()) return false;
+        ++sequence;
+        if (rows >= max_rows) return false;
+        // A backwards clock does not produce a burst or restart the cap.
+        if (rows && (poll_begin_xr_ns <= last_emit_xr_ns ||
+                     uint64_t(poll_begin_xr_ns) - uint64_t(last_emit_xr_ns) < uint64_t(interval_ns)))
+            return false;
+        last_emit_xr_ns = poll_begin_xr_ns;
+        ++rows;
+        return true;
+    }
+};
+}
diff --git a/common/codec_test/layer_filter.h b/common/codec_test/layer_filter.h
new file mode 100644
index 0000000..57af2fb
--- /dev/null
+++ b/common/codec_test/layer_filter.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdint>
+#include <optional>
+namespace wivrn::codec_test {
+constexpr uint64_t submitted_filter_flags(uint64_t requested, bool enabled, bool projection) {
+    return enabled && projection ? requested : 0;
+}
+struct layer_filter_snapshot {
+    uint64_t requested, submitted;
+    bool enabled, projection;
+    bool operator==(const layer_filter_snapshot&) const = default;
+};
+// Per stream; emit on first successful submit or actual configuration change.
+struct layer_filter_telemetry {
+    uint64_t generation = 0;
+    std::optional<layer_filter_snapshot> last;
+    void reset() { ++generation; last.reset(); }
+    bool observe(layer_filter_snapshot value) {
+        if (last && *last == value) return false;
+        last = value; return true;
+    }
+};
+}
diff --git a/common/codec_test/metadata.h b/common/codec_test/metadata.h
new file mode 100644
index 0000000..191893d
--- /dev/null
+++ b/common/codec_test/metadata.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "wivrn_packets.h"
+#include <bit>
+#include <cstdlib>
+#include <string_view>
+namespace wivrn::codec_test {
+inline bool enabled() {
+#ifdef WIVRN_CODEC_TESTS
+    const char* mode=std::getenv("WIVRN_CODEC_TEST");
+    return mode && (std::string_view(mode)=="vulkan-vr444"||std::string_view(mode)=="hevc-carrier"||std::string_view(mode)=="raw-rgba");
+#else
+    return false;
+#endif
+}
+// Canonical field-by-field hash: never hash padding or vector pointers.
+inline uint64_t warp_hash(const to_headset::video_stream_data_shard::view_info_t& v) {
+    uint64_t h=14695981039346656037ULL;
+    auto u=[&](uint64_t n){for(int i=0;i<8;++i){h^=uint8_t(n>>(i*8));h*=1099511628211ULL;}};
+    auto f=[&](float n){u(std::bit_cast<uint32_t>(n));};
+    u(v.display_time);u(v.alpha);
+    for(unsigned eye=0;eye<2;++eye){
+        auto p=v.pose[eye];f(p.orientation.x);f(p.orientation.y);f(p.orientation.z);f(p.orientation.w);
+        f(p.position.x);f(p.position.y);f(p.position.z);
+        auto a=v.fov[eye];f(a.angleLeft);f(a.angleRight);f(a.angleUp);f(a.angleDown);
+        for(auto* axis:{&v.foveation[eye].x,&v.foveation[eye].y}){u(axis->size());for(auto n:*axis)u(n);}
+    }
+    return h;
+}
+} // namespace
diff --git a/common/codec_test/publication_ledger.h b/common/codec_test/publication_ledger.h
new file mode 100644
index 0000000..6a294b4
--- /dev/null
+++ b/common/codec_test/publication_ledger.h
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "selection_trace.h"
+#include <memory>
+#include <stdexcept>
+
+namespace wivrn::codec_test::publication_ledger {
+using Frame = selection_trace::Frame;
+using History = std::array<Frame, selection_trace::decoder_count * selection_trace::history_slots>;
+inline constexpr std::size_t record_limit = 16384;
+
+inline bool equal(const Frame& a, const Frame& b) {
+    return a.present == b.present && a.frame == b.frame && a.warp == b.warp &&
+        a.view_display_time == b.view_display_time && a.receive == b.receive &&
+        a.ready == b.ready && a.alpha == b.alpha;
+}
+inline bool valid(const Frame& f) {
+    return f.present ? f.frame <= uint64_t(INT64_MAX) && f.view_display_time > 0 &&
+        f.receive > 0 && f.ready >= f.receive : equal(f, Frame{});
+}
+struct Event {
+    uint64_t epoch = 0;
+    bool reset = false;
+    std::size_t decoder = 0;
+    Frame added{}, evicted{};
+};
+static_assert(std::is_trivially_copyable_v<Event>);
+
+// Construct before callback workers start. Call reset(), publish() and mark()
+// only while holding the same external frames mutex. Records never change
+// after their complete assignment, and the count advances only afterward.
+// A mark captured under that mutex synchronizes all marked records with the
+// reader. The render thread may then read only that immutable prefix while
+// callback threads append later, distinct array elements.
+template<std::size_t Capacity = record_limit>
+class Ledger {
+    static_assert(Capacity > 0 && Capacity <= record_limit);
+    std::unique_ptr<std::array<Event, Capacity>> events = std::make_unique<std::array<Event, Capacity>>();
+    uint64_t count = 0, epoch = 0, lost = 0;
+    bool healthy = true;
+    void reject() noexcept {
+        healthy = false;
+        if (lost < uint64_t(INT64_MAX)) ++lost;
+    }
+    void append(const Event& event) noexcept {
+        if (count == Capacity) { reject(); return; }
+        (*events)[count] = event;
+        ++count;
+    }
+public:
+    class Mark {
+        const Ledger* owner = nullptr;
+        uint64_t count = 0, epoch = 0, lost = 0;
+        bool healthy = false;
+        friend class Ledger;
+    public:
+        uint64_t records() const noexcept { return count; }
+        uint64_t generation() const noexcept { return epoch; }
+        uint64_t dropped() const noexcept { return lost; }
+        bool valid() const noexcept { return healthy; }
+    };
+    static constexpr std::size_t capacity = Capacity;
+    Ledger() = default;
+    Ledger(const Ledger&) = delete;
+    Ledger& operator=(const Ledger&) = delete;
+    void reset() noexcept {
+        if (epoch == uint64_t(INT64_MAX)) { reject(); return; }
+        ++epoch;
+        append(Event{.epoch = epoch, .reset = true});
+    }
+    void publish(std::size_t decoder, const Frame& added, const Frame& evicted) noexcept {
+        if (!epoch || decoder >= selection_trace::decoder_count || !added.present || !valid(added) || !valid(evicted)) {
+            reject(); return;
+        }
+        append(Event{.epoch = epoch, .decoder = decoder, .added = added, .evicted = evicted});
+    }
+    Mark mark() const noexcept {
+        Mark result;
+        result.owner = this; result.count = count; result.epoch = epoch;
+        result.lost = lost; result.healthy = healthy;
+        return result;
+    }
+    bool owns(const Mark& mark) const noexcept { return mark.owner == this; }
+    const Event& at(const Mark& mark, uint64_t index) const {
+        // Do not inspect mutable count/epoch here: this is the unlocked reader.
+        if (mark.owner != this || index >= mark.count || index >= Capacity)
+            throw std::out_of_range("publication prefix access outside captured mark");
+        return (*events)[index];
+    }
+};
+
+// Render-thread owned. Flush each checkpoint before serializing the matching
+// candidate trace record. This exports a prefix without needing a destructor
+// or claiming a complete process tail; I/O remains outside frames_mutex.
+template<std::size_t Capacity = record_limit>
+class Exporter {
+    uint64_t written = 0, last_selection = 0;
+    bool started = false, healthy = true;
+    const Ledger<Capacity>* owner = nullptr;
+public:
+    bool write(std::ostream& out, const Ledger<Capacity>& ledger,
+               const typename Ledger<Capacity>::Mark& mark, uint64_t selection,
+               const History& history) {
+        if (!healthy || (owner && owner != &ledger) || !ledger.owns(mark) || !selection || selection != last_selection + 1 || mark.records() < written) {
+            healthy = false;
+            return false;
+        }
+        owner = &ledger;
+        // Any stream exception or failed prefix access leaves export sticky-failed.
+        // A partial prefix must never be retried as if nothing was written.
+        healthy = false;
+        if (!started) {
+            out << "{\"kind\":\"header\",\"schema\":1,\"capacity\":" << Capacity
+                << ",\"clock\":\"client_xr_ns\",\"coverage\":\"scene_start_through_last_selection_checkpoint\"}\n";
+            started = true;
+        }
+        for (; written < mark.records(); ++written) {
+            const auto& event = ledger.at(mark, written);
+            out << "{\"kind\":\"" << (event.reset ? "reset" : "publish") << "\",\"sequence\":" << written + 1
+                << ",\"epoch\":" << event.epoch;
+            if (!event.reset) {
+                out << ",\"decoder\":" << event.decoder << ",\"added\":{";
+                selection_trace::write_frame(out, event.added);
+                out << "},\"evicted\":{";
+                selection_trace::write_frame(out, event.evicted);
+                out << '}';
+            }
+            out << "}\n";
+        }
+        out << "{\"kind\":\"checkpoint\",\"selection_sequence\":" << selection
+            << ",\"prefix_records\":" << mark.records() << ",\"epoch\":" << mark.generation()
+            << ",\"dropped\":" << mark.dropped() << ",\"valid\":" << (mark.valid() ? "true" : "false")
+            << ",\"history\":[";
+        for (std::size_t i = 0; i < history.size(); ++i) {
+            if (i) out << ',';
+            out << "{\"decoder\":" << i / selection_trace::history_slots << ",\"slot\":" << i % selection_trace::history_slots << ',';
+            selection_trace::write_frame(out, history[i]); out << '}';
+        }
+        out << "]}\n";
+        out.flush();
+        last_selection = selection;
+        healthy = bool(out) && mark.valid();
+        return healthy;
+    }
+};
+} // namespace wivrn::codec_test::publication_ledger
diff --git a/common/codec_test/selection_policy.h b/common/codec_test/selection_policy.h
new file mode 100644
index 0000000..e3d69d9
--- /dev/null
+++ b/common/codec_test/selection_policy.h
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "selection_trace.h"
+#include <algorithm>
+#include <limits>
+
+namespace wivrn::codec_test::selection_policy {
+using selection_trace::Frame;
+using selection_trace::Policy;
+using selection_trace::Reason;
+using Pair = std::array<Frame, selection_trace::decoder_count>;
+using History = std::array<Frame, selection_trace::decoder_count * selection_trace::history_slots>;
+using Slots = std::array<int, selection_trace::decoder_count>;
+inline constexpr Slots absent{-1, -1, -1};
+
+// This is an encoded-frame scheduling experiment. Encoded frame IDs and source
+// prediction targets do not identify application generations or photon times.
+inline int64_t period_bound(int64_t target, int64_t period, int64_t previous_target) {
+    if (period <= 0 || previous_target <= 0 || target <= previous_target)
+        return 0;
+    return std::min(period, target - previous_target);
+}
+
+inline bool matches(const Frame& left, const Frame& right, bool strict) {
+    return left.present && right.present && left.frame == right.frame && left.warp == right.warp &&
+           (!strict || (left.view_display_time == right.view_display_time && left.alpha == right.alpha));
+}
+
+inline Slots pair_slots(const History& history, int left_slot, bool alpha, bool strict) {
+    const auto& left = history[left_slot];
+    if (!left.present || (strict && (left.alpha != alpha || left.view_display_time <= 0)))
+        return absent;
+    Slots slots{left_slot, -1, -1};
+    for (std::size_t decoder = 1; decoder < 2 + std::size_t(alpha); ++decoder) {
+        for (std::size_t slot = 0; slot < selection_trace::history_slots; ++slot)
+            if (matches(left, history[decoder * selection_trace::history_slots + slot], strict)) {
+                slots[decoder] = static_cast<int>(slot);
+                break;
+            }
+        if (slots[decoder] < 0) return absent;
+    }
+    return slots;
+}
+
+inline Pair snapshot(const History& history, const Slots& slots) {
+    Pair result{};
+    for (std::size_t decoder = 0; decoder < slots.size(); ++decoder)
+        if (slots[decoder] >= 0)
+            result[decoder] = history[decoder * selection_trace::history_slots + slots[decoder]];
+    return result;
+}
+
+// Preserve the old test decoder.frame(frame_index) lookup for the default,
+// including its first-ID behavior if malformed duplicate IDs carry two warps.
+// Bounded selection uses pair_slots(..., true) and never uses this lookup.
+inline Slots legacy_resource_slots(const History& history, uint64_t frame, bool alpha) {
+    Slots result = absent;
+    for (std::size_t decoder = 0; decoder < 2 + std::size_t(alpha); ++decoder)
+        for (std::size_t slot = 0; slot < selection_trace::history_slots; ++slot) {
+            const auto& candidate = history[decoder * selection_trace::history_slots + slot];
+            if (candidate.present && candidate.frame == frame) {
+                result[decoder] = static_cast<int>(slot);
+                break;
+            }
+        }
+    return result;
+}
+
+inline bool coherent(const Pair& pair) {
+    return matches(pair[0], pair[1], true) && pair[0].view_display_time > 0 &&
+           (pair[0].alpha ? matches(pair[0], pair[2], true) : !pair[2].present);
+}
+
+// Unsigned subtraction avoids signed-overflow UB even on adversarial targets.
+inline uint64_t distance(int64_t a, int64_t b) {
+    return a >= b ? uint64_t(a) - uint64_t(b) : uint64_t(b) - uint64_t(a);
+}
+
+inline bool not_regressing(const Frame& candidate, const Frame& reference) {
+    if (!reference.present) return true;
+    if (candidate.frame < reference.frame || candidate.view_display_time < reference.view_display_time)
+        return false;
+    return candidate.frame != reference.frame ||
+           (candidate.warp == reference.warp && candidate.view_display_time == reference.view_display_time &&
+            candidate.alpha == reference.alpha);
+}
+
+struct Decision {
+    bool alpha_required = false, fallback = false;
+    int64_t max_ahead = 0;
+    Reason reason = Reason::unavailable;
+    Slots chosen_slots = absent, closest_slots = absent;
+    std::array<bool, selection_trace::history_slots> eligible_left_slots{};
+    Pair selected{}, closest{};
+};
+
+inline Decision choose(const History& history, const Pair& previous, Policy policy,
+                       int64_t target, int64_t period, int64_t previous_target) {
+    Decision out;
+    out.alpha_required = history[0].present && history[0].alpha;
+    out.max_ahead = period_bound(target, period, previous_target);
+    uint64_t closest_distance = std::numeric_limits<uint64_t>::max();
+    for (int slot = 0; slot < int(selection_trace::history_slots); ++slot) {
+        auto slots = pair_slots(history, slot, out.alpha_required, false);
+        if (slots[0] < 0) continue;
+        const auto delta = distance(history[slot].view_display_time, target);
+        if (out.closest_slots[0] < 0 || delta < closest_distance) {
+            out.closest_slots = slots;
+            closest_distance = delta;
+        }
+        if (policy == Policy::closest_target) out.eligible_left_slots[slot] = true;
+    }
+    if (out.closest_slots[0] >= 0)
+        out.closest_slots = legacy_resource_slots(history, history[out.closest_slots[0]].frame, out.alpha_required);
+    out.closest = snapshot(history, out.closest_slots);
+    if (policy == Policy::closest_target && out.closest_slots[0] >= 0) {
+        out.chosen_slots = out.closest_slots;
+        out.selected = out.closest;
+        out.reason = Reason::closest_target;
+        return out;
+    }
+    if (policy == Policy::bounded_newest && out.closest_slots[0] >= 0) {
+        for (int slot = 0; slot < int(selection_trace::history_slots); ++slot) {
+            const auto slots = pair_slots(history, slot, out.alpha_required, true);
+            if (slots[0] < 0) continue;
+            const auto& candidate = history[slot];
+            if (!not_regressing(candidate, out.closest[0]) ||
+                (coherent(previous) && !not_regressing(candidate, previous[0]))) continue;
+            if (candidate.view_display_time > target &&
+                distance(candidate.view_display_time, target) > uint64_t(out.max_ahead)) continue;
+            if (out.max_ahead == 0 && !matches(candidate, out.closest[0], true)) continue;
+            out.eligible_left_slots[slot] = true;
+            if (out.chosen_slots[0] < 0 || candidate.frame > out.selected[0].frame) {
+                out.chosen_slots = slots;
+                out.selected = snapshot(history, slots);
+            }
+        }
+        if (out.chosen_slots[0] >= 0) {
+            out.reason = Reason::bounded_newest;
+            return out;
+        }
+    }
+    out.fallback = true;
+    out.reason = out.closest_slots[0] < 0 ? Reason::no_complete_fallback : Reason::no_eligible_fallback;
+    if (policy == Policy::closest_target || coherent(previous)) out.selected = previous;
+    return out;
+}
+} // namespace wivrn::codec_test::selection_policy
diff --git a/common/codec_test/selection_trace.h b/common/codec_test/selection_trace.h
new file mode 100644
index 0000000..a21eac6
--- /dev/null
+++ b/common/codec_test/selection_trace.h
@@ -0,0 +1,232 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <ostream>
+#include <type_traits>
+
+namespace wivrn::codec_test::selection_trace {
+inline constexpr std::size_t decoder_count = 3, history_slots = 3;
+inline constexpr uint64_t record_limit = 4096;
+
+// Plain fixed-size copies only. No resource ownership, pose vectors, allocation,
+// clock calls or serialization are needed while the live frames mutex is held.
+struct Frame {
+    bool present = false;
+    uint64_t frame = 0, warp = 0;
+    int64_t view_display_time = 0, receive = 0, ready = 0;
+    bool alpha = false;
+};
+enum class Policy { closest_target, bounded_newest };
+enum class Reason { unavailable, closest_target, bounded_newest, no_complete_fallback, no_eligible_fallback };
+
+// Count render attempts separately from successful projection submissions.
+// Constant storage; render-thread owned. No allocation, clocks, locks, or I/O.
+enum class Skip : std::size_t { should_not_render, decoders_unavailable, shutdown, no_complete_pair, retained_pair, count };
+inline constexpr std::array<const char*, static_cast<std::size_t>(Skip::count)> skip_names{
+    "should_not_render", "decoders_unavailable", "shutdown", "no_complete_pair", "retained_pair"};
+inline bool increment_attempt_count(uint64_t& value) {
+    if (value >= static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) return false;
+    ++value;
+    return true;
+}
+struct Attempts {
+    uint64_t render_attempt = 0, previous_submission_attempt = 0;
+    int64_t previous_submission_target = 0;
+    std::array<uint64_t, skip_names.size()> skipped{};
+    uint64_t aborted = 0;
+    bool valid = true;
+};
+class AttemptLedger {
+    Attempts interval;
+    int64_t previous_render_target = 0, current_target = 0;
+    bool active = false;
+    void increment(uint64_t& value) {
+        if (!increment_attempt_count(value)) interval.valid = false;
+    }
+public:
+    bool enabled = false;
+    void begin(int64_t target, int64_t prior_target) {
+        if (!enabled) return;
+        if (active) abort();
+        if (target <= 0 || prior_target != previous_render_target ||
+            (previous_render_target && target <= previous_render_target))
+            interval.valid = false;
+        increment(interval.render_attempt);
+        current_target = target;
+        previous_render_target = target;
+        active = true;
+    }
+    void skip(Skip reason) {
+        if (!enabled) return;
+        const auto index = static_cast<std::size_t>(reason);
+        if (!active || index >= interval.skipped.size()) { interval.valid = false; return; }
+        increment(interval.skipped[index]);
+        active = false;
+    }
+    void abort() {
+        if (!enabled || !active) return;
+        increment(interval.aborted);
+        interval.valid = false; // A caught failure is never a benign skipped frame.
+        active = false;
+    }
+    Attempts submit() {
+        if (!enabled) return {};
+        if (!active) interval.valid = false;
+        const auto snapshot = interval;
+        interval.previous_submission_attempt = interval.render_attempt;
+        interval.previous_submission_target = current_target;
+        interval.skipped.fill(0);
+        interval.aborted = 0;
+        active = false;
+        return snapshot;
+    }
+};
+// Any return/exception that did not explicitly finish an attempt poisons future
+// accounting. Failed xrEndFrame or partial rendering cannot masquerade as skips.
+struct AttemptGuard {
+    AttemptLedger& ledger;
+    AttemptGuard(AttemptLedger& value, int64_t target, int64_t prior) : ledger(value) { ledger.begin(target, prior); }
+    ~AttemptGuard() { ledger.abort(); }
+    AttemptGuard(const AttemptGuard&) = delete;
+    AttemptGuard& operator=(const AttemptGuard&) = delete;
+};
+
+struct Record {
+    uint32_t schema = 2; // Offline policy fixtures remain schema 2; live opts in to 3.
+    uint64_t sequence = 0;
+    bool after_fence = false, alpha_required = false, repeat_previous = false;
+    bool projection_submitted = false;
+    int64_t wait_begin = 0, wait_end = 0, render_entry = 0;
+    int64_t selection_begin = 0, selection_end = 0, predicted_display = 0;
+    int64_t end_frame_return = 0;
+    Policy policy = Policy::closest_target;
+    int64_t predicted_period = 0, previous_predicted_display = 0, max_ahead = 0;
+    bool selected_alpha_required = false;
+    Reason reason = Reason::unavailable;
+    std::array<Frame, decoder_count * history_slots> history{};
+    std::array<Frame, decoder_count> selected{}, closest{}, previous{};
+    std::array<int, decoder_count> chosen_slots{-1, -1, -1};
+    std::array<bool, history_slots> eligible_left_slots{};
+    Attempts attempts;
+};
+static_assert(std::is_trivially_copyable_v<Frame> && std::is_trivially_copyable_v<Record>);
+
+inline bool same_selection(const std::array<Frame, decoder_count>& a,
+                           const std::array<Frame, decoder_count>& b) {
+    if (!a[0].present || !a[1].present || !b[0].present || !b[1].present)
+        return false;
+    for (std::size_t i = 0; i < decoder_count; ++i)
+        if (a[i].present != b[i].present ||
+            (a[i].present && (a[i].frame != b[i].frame || a[i].warp != b[i].warp)))
+            return false;
+    return true;
+}
+
+struct Budget {
+    bool enabled = false;
+    uint64_t records = 0, dropped = 0;
+    bool capture() const { return enabled && records < record_limit; }
+    // Called only following successful xrEndFrame for a rendered selection.
+    // Once capped, the existing presentation log carries the explicit drop count.
+    bool commit() {
+        if (!enabled) return false;
+        if (records >= record_limit) { ++dropped; return false; }
+        ++records;
+        return true;
+    }
+};
+
+inline const char* reason_name(Reason value) {
+    switch (value) {
+    case Reason::closest_target: return "closest_target";
+    case Reason::bounded_newest: return "bounded_newest";
+    case Reason::no_complete_fallback: return "no_complete_fallback";
+    case Reason::no_eligible_fallback: return "no_eligible_fallback";
+    default: return "unavailable";
+    }
+}
+
+inline const char* policy_name(Policy value) {
+    return value == Policy::bounded_newest ? "bounded-newest" : "closest-target";
+}
+
+inline void write_frame(std::ostream& out, const Frame& frame) {
+    out << "\"present\":" << (frame.present ? "true" : "false");
+    if (frame.present)
+        out << ",\"frame\":" << frame.frame << ",\"warp\":" << frame.warp
+            << ",\"view_display_time_xr_ns\":" << frame.view_display_time
+            << ",\"receive_xr_ns\":" << frame.receive << ",\"ready_xr_ns\":" << frame.ready
+            << ",\"alpha\":" << (frame.alpha ? "true" : "false");
+}
+
+inline void write_attempts(std::ostream& out, const Attempts& a) {
+    out << "{\"render_attempt\":" << a.render_attempt
+        << ",\"previous_submission_attempt\":" << a.previous_submission_attempt
+        << ",\"previous_submission_target_xr_ns\":" << a.previous_submission_target
+        << ",\"aborted\":" << a.aborted << ",\"valid\":" << (a.valid ? "true" : "false")
+        << ",\"skipped\":{";
+    for (std::size_t i = 0; i < a.skipped.size(); ++i) {
+        if (i) out << ',';
+        out << '\"' << skip_names[i] << "\":" << a.skipped[i];
+    }
+    out << "}}";
+}
+
+// Invoke outside frames_mutex, only after successful xrEndFrame.
+inline void write_json(std::ostream& out, const Record& r) {
+    out << "{\"schema\":" << r.schema << ",\"sequence\":" << r.sequence
+        << ",\"selection_phase\":\"" << (r.after_fence ? "after-fence" : "early") << "\""
+        << ",\"selection_policy\":\"" << policy_name(r.policy) << "\""
+        << ",\"predicted_display_period_xr_ns\":" << r.predicted_period
+        << ",\"previous_predicted_display_xr_ns\":" << r.previous_predicted_display
+        << ",\"max_ahead_xr_ns\":" << r.max_ahead
+        << ",\"wait_frame_begin_xr_ns\":" << r.wait_begin
+        << ",\"wait_frame_end_xr_ns\":" << r.wait_end
+        << ",\"render_entry_xr_ns\":" << r.render_entry
+        << ",\"selection_begin_xr_ns\":" << r.selection_begin
+        << ",\"selection_end_xr_ns\":" << r.selection_end
+        << ",\"predicted_display_xr_ns\":" << r.predicted_display
+        << ",\"end_frame_return_xr_ns\":" << r.end_frame_return
+        << ",\"alpha_required\":" << (r.alpha_required ? "true" : "false")
+        << ",\"selected_alpha_required\":" << (r.selected_alpha_required ? "true" : "false")
+        << ",\"projection_submitted\":" << (r.projection_submitted ? "true" : "false")
+        << ",\"reason\":\"" << reason_name(r.reason) << "\""
+        << ",\"repeat_previous\":" << (r.repeat_previous ? "true" : "false")
+        << ",\"history\":[";
+    for (std::size_t i = 0; i < r.history.size(); ++i) {
+        if (i) out << ',';
+        out << "{\"decoder\":" << i / history_slots << ",\"slot\":" << i % history_slots << ',';
+        write_frame(out, r.history[i]); out << '}';
+    }
+    auto frames = [&](const char* key, const auto& values) {
+        out << "],\"" << key << "\":[";
+        for (std::size_t i = 0; i < values.size(); ++i) {
+            if (i) out << ',';
+            out << "{\"decoder\":" << i << ',';
+            write_frame(out, values[i]); out << '}';
+        }
+    };
+    frames("selected", r.selected);
+    frames("closest", r.closest);
+    frames("previous", r.previous);
+    out << "],\"chosen_slots\":[";
+    for (std::size_t i = 0; i < r.chosen_slots.size(); ++i) {
+        if (i) out << ',';
+        out << r.chosen_slots[i];
+    }
+    out << "],\"eligible_left_slots\":[";
+    for (std::size_t i = 0; i < r.eligible_left_slots.size(); ++i) {
+        if (i) out << ',';
+        out << (r.eligible_left_slots[i] ? "true" : "false");
+    }
+    out << ']';
+    if (r.schema == 3) {
+        out << ",\"render_attempts\":";
+        write_attempts(out, r.attempts);
+    }
+    out << "}\n";
+}
+}
diff --git a/common/codec_test/stereo_admission.h b/common/codec_test/stereo_admission.h
new file mode 100644
index 0000000..128dadd
--- /dev/null
+++ b/common/codec_test/stereo_admission.h
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "wire.h"
+#include <algorithm>
+#include <array>
+#include <condition_variable>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <utility>
+
+namespace wivrn::codec_test {
+// One generation owns one coordinator. Workers pull their own jobs; this class
+// never stores callbacks or decoder pointers. Payload memory is bounded by two
+// active eyes plus at most two pending frame IDs (four pending eye payloads).
+template<class Job> class StereoAdmission {
+public:
+    struct Stats {
+        uint64_t offered_eyes=0, admitted_pairs=0, completed_pairs=0, failed_pairs=0;
+        uint64_t dropped_eyes=0, stale_eyes=0, duplicate_eyes=0, mismatched_pairs=0;
+        uint64_t abandoned_pairs=0, pending_dropped_pairs=0, orphan_dropped_eyes=0;
+        size_t pending_frames=0;
+        bool active=false, closed=false;
+    };
+private:
+    struct Entry { Header header; Job job; };
+    using Pair=std::array<std::optional<Entry>,2>;
+    mutable std::mutex mutex;
+    std::condition_variable cv;
+    std::map<uint64_t,Pair> pending;
+    Pair active;
+    std::optional<uint64_t> active_frame, retired_through;
+    std::array<bool,2> taken{}, done{};
+    bool active_failed=false, closed=false;
+    Stats stats;
+    static size_t count(const Pair& pair) { return size_t(bool(pair[0]))+size_t(bool(pair[1])); }
+    static bool compatible(const Header& a,const Header& b) {
+        return a.kind==b.kind && a.width==b.width && a.height==b.height && a.frame==b.frame && a.warp==b.warp;
+    }
+    void discard_pending(const Pair& pair) {
+        auto eyes=count(pair);stats.dropped_eyes+=eyes;
+        if(eyes==2)++stats.pending_dropped_pairs;else stats.orphan_dropped_eyes+=eyes;
+    }
+    void retire(uint64_t frame) {
+        if(!retired_through || frame>*retired_through)retired_through=frame;
+        for(auto it=pending.begin();it!=pending.end()&&it->first<=frame;){
+            discard_pending(it->second);it=pending.erase(it);
+        }
+    }
+    void admit() {
+        if(closed || active_frame)return;
+        auto chosen=pending.end();
+        for(auto it=pending.rbegin();it!=pending.rend();++it)
+            if(it->second[0]&&it->second[1]){chosen=std::prev(it.base());break;}
+        if(chosen==pending.end())return;
+        active_frame=chosen->first;active=std::move(chosen->second);pending.erase(chosen);
+        retire(*active_frame);taken={};done={};active_failed=false;++stats.admitted_pairs;
+        cv.notify_all();
+    }
+    void bound_pending() {
+        // Retain the newest complete pair even if newer orphan frames arrive.
+        // Otherwise a consistently early eye can evict every decodable pair.
+        while(pending.size()>2){
+            auto protected_pair=pending.end();
+            for(auto it=pending.rbegin();it!=pending.rend();++it)
+                if(it->second[0]&&it->second[1]){protected_pair=std::prev(it.base());break;}
+            auto victim=pending.begin();if(victim==protected_pair)++victim;
+            discard_pending(victim->second);pending.erase(victim);
+        }
+    }
+public:
+    bool submit(Header header,Job job) {
+        if(header.eye>1)throw std::invalid_argument("stereo admission eye must be 0 or 1");
+        std::lock_guard lock(mutex);++stats.offered_eyes;
+        if(closed){++stats.dropped_eyes;return false;}
+        if(retired_through && header.frame<=*retired_through){
+            ++stats.dropped_eyes;
+            if(active_frame && header.frame==*active_frame)++stats.duplicate_eyes;else ++stats.stale_eyes;
+            return false;
+        }
+        auto& pair=pending[header.frame];
+        if(pair[header.eye]){++stats.dropped_eyes;++stats.duplicate_eyes;return false;}
+        if(pair[1-header.eye] && !compatible(header,pair[1-header.eye]->header)){
+            ++stats.mismatched_pairs;++stats.dropped_eyes;
+            // Retire both halves and older pending data; a late duplicate of a
+            // corrupt identity must never reconstruct that rejected frame ID.
+            retire(header.frame);return false;
+        }
+        pair[header.eye].emplace(Entry{header,std::move(job)});
+        admit();bound_pending();return true;
+    }
+    std::optional<Job> wait_take(unsigned eye) {
+        if(eye>1)throw std::invalid_argument("stereo admission eye must be 0 or 1");
+        std::unique_lock lock(mutex);
+        cv.wait(lock,[&]{return closed || (active_frame && !taken[eye]);});
+        if(closed)return {};
+        taken[eye]=true;
+        auto result=std::move(active[eye]->job);active[eye].reset();
+        return result;
+    }
+    void finish(unsigned eye,uint64_t frame,bool success) {
+        std::lock_guard lock(mutex);
+        if(eye>1 || !active_frame || *active_frame!=frame || !taken[eye] || done[eye])
+            throw std::logic_error("invalid stereo completion");
+        done[eye]=true;active_failed|=!success;
+        if(done[0]&&done[1]){
+            if(active_failed)++stats.failed_pairs;else ++stats.completed_pairs;
+            active_frame.reset();admit();
+        }
+        cv.notify_all();
+    }
+    void stop() {
+        std::lock_guard lock(mutex);
+        if(closed)return;
+        closed=true;
+        for(const auto& [frame,pair]:pending)discard_pending(pair);
+        pending.clear();
+        if(active_frame){++stats.abandoned_pairs;stats.dropped_eyes+=count(active);active={};}
+        cv.notify_all();
+    }
+    Stats snapshot() const {
+        std::lock_guard lock(mutex);auto copy=stats;
+        copy.pending_frames=pending.size();copy.active=bool(active_frame);copy.closed=closed;return copy;
+    }
+};
+}
diff --git a/common/codec_test/stereo_publication.h b/common/codec_test/stereo_publication.h
new file mode 100644
index 0000000..002bb9d
--- /dev/null
+++ b/common/codec_test/stereo_publication.h
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <span>
+
+namespace wivrn::codec_test::stereo_publication {
+
+// Compare every serialized view field, including float bit patterns, not padding
+// or a probabilistic hash. The native translation-unit check instantiates this
+// with video_stream_data_shard::view_info_t.
+template<class View>
+bool same_view(const View& a, const View& b) noexcept {
+    if (a.display_time != b.display_time || a.alpha != b.alpha) return false;
+    const auto same_float = [](float x, float y) { return std::bit_cast<uint32_t>(x) == std::bit_cast<uint32_t>(y); };
+    for (unsigned eye = 0; eye < 2; ++eye) {
+        const auto& p = a.pose[eye]; const auto& q = b.pose[eye];
+        const auto& f = a.fov[eye]; const auto& g = b.fov[eye];
+        if (!same_float(p.orientation.x, q.orientation.x) || !same_float(p.orientation.y, q.orientation.y)
+            || !same_float(p.orientation.z, q.orientation.z) || !same_float(p.orientation.w, q.orientation.w)
+            || !same_float(p.position.x, q.position.x) || !same_float(p.position.y, q.position.y)
+            || !same_float(p.position.z, q.position.z) || !same_float(f.angleLeft, g.angleLeft)
+            || !same_float(f.angleRight, g.angleRight) || !same_float(f.angleUp, g.angleUp)
+            || !same_float(f.angleDown, g.angleDown) || a.foveation[eye].x != b.foveation[eye].x
+            || a.foveation[eye].y != b.foveation[eye].y) return false;
+    }
+    return true;
+}
+
+// Caller holds the existing decoder shared lock and frames exclusive lock, and
+// has checked both accumulator identities. Both producer uploads must already
+// have completed. No callback, allocation, I/O or throwing work occurs between
+// the first history change and completion of the second history change.
+// On false, incoming handles and both histories are unchanged. On true, incoming
+// holds the evicted objects so their feedback/lifetime can be handled unlocked.
+template<class Handle>
+bool replace_pair(std::array<std::span<Handle>, 2> histories,
+                  std::array<Handle, 2>& incoming, int64_t ready) noexcept {
+    if (!incoming[0] || !incoming[1] || histories[0].empty() || histories[1].empty() || ready <= 0)
+        return false;
+    const auto& left = *incoming[0]; const auto& right = *incoming[1];
+    if (left.feedback.stream_index != 0 || right.feedback.stream_index != 1
+        || left.feedback.frame_index != right.feedback.frame_index
+        || !same_view(left.view_info, right.view_info)
+        || left.feedback.received_first_packet <= 0 || right.feedback.received_first_packet <= 0
+        || left.feedback.received_first_packet > ready || right.feedback.received_first_packet > ready)
+        return false;
+    for (unsigned eye = 0; eye < 2; ++eye)
+        for (const auto& retained : histories[eye])
+            if (retained && retained->feedback.frame_index >= left.feedback.frame_index) return false;
+    incoming[0]->feedback.received_from_decoder = ready;
+    incoming[1]->feedback.received_from_decoder = ready;
+    for (unsigned eye = 0; eye < 2; ++eye) {
+        auto history = histories[eye];
+        std::rotate(history.begin(), history.begin() + 1, history.end());
+        std::swap(incoming[eye], history.back());
+    }
+    return true;
+}
+} // namespace wivrn::codec_test::stereo_publication
diff --git a/common/codec_test/submitted_capture.h b/common/codec_test/submitted_capture.h
new file mode 100644
index 0000000..35ab437
--- /dev/null
+++ b/common/codec_test/submitted_capture.h
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+// Diagnostic acquisition contract; no image quality or displayed-pixel verdict.
+#include <simdjson.h>
+#include <array>
+#include <cerrno>
+#include <cstdint>
+#include <filesystem>
+#include <fcntl.h>
+#include <fstream>
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <unistd.h>
+
+namespace wivrn::codec_test::submitted_capture {
+struct Config { bool enabled = false; uint32_t max_pairs = 6, frame_stride = 90; };
+inline Config parse(std::string_view text) {
+    if (text.empty() || text.size() > 1024) throw std::runtime_error("quality capture config size");
+    simdjson::dom::parser parser;
+    auto document = parser.parse(text.data(), text.size());
+    Config config; unsigned seen = 0;
+    for (auto field : document.get_object()) {
+        unsigned bit;
+        if (field.key == "enabled") { bit = 1; config.enabled = bool(field.value.get_bool()); }
+        else if (field.key == "max_pairs") { bit = 2; auto n = uint64_t(field.value.get_uint64());
+            if (n < 1 || n > 8) throw std::runtime_error("quality capture max_pairs"); config.max_pairs = n; }
+        else if (field.key == "frame_stride") { bit = 4; auto n = uint64_t(field.value.get_uint64());
+            if (n < 1 || n > 900) throw std::runtime_error("quality capture frame_stride"); config.frame_stride = n; }
+        else throw std::runtime_error("quality capture unknown config key");
+        if (seen & bit) throw std::runtime_error("quality capture duplicate config key");
+        seen |= bit;
+    }
+    if (!(seen & 1)) throw std::runtime_error("quality capture enabled key required");
+    return config;
+}
+inline Config load(const std::filesystem::path& path) {
+    if (!std::filesystem::exists(path)) return {};
+    if (std::filesystem::file_size(path) > 1024) throw std::runtime_error("quality capture config size");
+    std::ifstream file(path, std::ios::binary);
+    if (!file) throw std::runtime_error("quality capture config read");
+    std::string text((std::istreambuf_iterator<char>(file)), {});
+    return parse(text);
+}
+inline uint64_t bytes(uint32_t width, uint32_t height) {
+    if (!width || !height || width > 4096 || height > 4096 || uint64_t(width)*height > 4*1024*1024)
+        throw std::runtime_error("quality capture eye exceeds 4MP/4096-axis bound");
+    return uint64_t(width)*height*4;
+}
+struct Budget {
+    Config config;
+    uint32_t attempts = 0;
+    bool have_frame = false;
+    uint64_t last_frame = 0;
+    bool take(uint64_t frame) {
+        if (!config.enabled || attempts >= config.max_pairs) return false;
+        if (have_frame && (frame <= last_frame || frame-last_frame < config.frame_stride)) return false;
+        have_frame = true; last_frame = frame; ++attempts; return true;
+    }
+};
+// O_EXCL never overwrites existing evidence. A short write leaves an incomplete
+// artifact and throws; the final pair.json completion marker is written last.
+inline void exclusive_write(const std::filesystem::path& path, std::span<const uint8_t> data) {
+    int fd = ::open(path.c_str(), O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC, 0600);
+    if (fd < 0) throw std::runtime_error("quality capture exclusive output open");
+    size_t offset = 0;
+    while (offset < data.size()) {
+        const auto n = ::write(fd, data.data()+offset, data.size()-offset);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) { ::close(fd); throw std::runtime_error("quality capture output write"); }
+        offset += size_t(n);
+    }
+    const int synced = ::fsync(fd), closed = ::close(fd);
+    if (synced || closed) throw std::runtime_error("quality capture output sync/close");
+}
+inline void exclusive_write(const std::filesystem::path& path, const std::string& text) {
+    exclusive_write(path, std::span(reinterpret_cast<const uint8_t*>(text.data()), text.size()));
+}
+} // namespace
diff --git a/common/codec_test/vr444/codec.cpp b/common/codec_test/vr444/codec.cpp
new file mode 100644
index 0000000..af034b1
--- /dev/null
+++ b/common/codec_test/vr444/codec.cpp
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: MIT
+#include "codec.hpp"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <random>
+#include <stdexcept>
+#include <array>
+namespace vr444 {
+static void require(bool v, const char* m) { if (!v) throw std::runtime_error(m); }
+static unsigned blocks(unsigned w, unsigned h) {
+    require(w && h && w<=4096 && h<=4096 && uint64_t(w)*h<=8388608, "invalid dimensions");
+    return ((w+15)/16)*((h+15)/16);
+}
+// Floor division is explicit; C++ signed right shift is not relied upon.
+static int half(int x) { return x>=0 ? x/2 : -((-x+1)/2); }
+static unsigned zz(int x) { return x>=0 ? unsigned(2*x) : unsigned(-2*x-1); }
+static int unzz(unsigned x) { return (x&1) ? -int((x+1)/2) : int(x/2); }
+static void transform(int* a, bool inverse) {
+    int t[16];
+    for(int n=inverse?2:16; inverse?n<=16:n>=2; n=inverse?n*2:n/2) {
+        for(int axis=0;axis<2;axis++) {
+            bool col=inverse ? axis==0 : axis==1;
+            for(int line=0;line<n;line++) {
+                auto pos=[&](int i){ return col ? i*16+line : line*16+i; };
+                for(int i=0;i<n/2;i++) {
+                    if(!inverse) {
+                        int d=a[pos(2*i)]-a[pos(2*i+1)];
+                        t[i]=a[pos(2*i+1)]+half(d); t[i+n/2]=d;
+                    } else {
+                        int d=a[pos(i+n/2)], b=a[pos(i)]-half(d);
+                        t[2*i]=b+d; t[2*i+1]=b;
+                    }
+                }
+                for(int i=0;i<n;i++) a[pos(i)]=t[i];
+            }
+        }
+    }
+}
+struct Bits {
+    uint32_t* p; unsigned size, bit=0;
+    void put(unsigned v,unsigned n) {
+        require(bit+n<=size*32,"slot overflow");
+        for(unsigned i=0;i<n;i++,bit++) p[bit/32]|=((v>>i)&1)<<(bit%32);
+    }
+    unsigned get(unsigned n) {
+        require(n<=16 && bit+n<=size*32,"truncated coefficient");
+        const unsigned word=bit/32,shift=bit%32;
+        unsigned value=p[word]>>shift;
+        if(shift+n>32)value|=p[word+1]<<(32-shift);
+        bit+=n;return value&((1u<<n)-1);
+    }
+};
+Frame encode(const std::vector<uint32_t>& rgba,unsigned w,unsigned h,unsigned q,const std::vector<uint32_t>& tile_q) {
+    unsigned count=blocks(w,h); require(q>=1 && q<=1024,"invalid q");
+    require(rgba.size()==size_t(w)*h,"invalid input size");
+    Frame f{w,h,q,std::vector<uint32_t>(size_t(count)*SLOT_WORDS),std::vector<uint32_t>(count)};
+    require(tile_q.empty() || tile_q.size()==count,"invalid quantizer map");
+    f.tile_q=tile_q;
+    for(unsigned b=0;b<count;b++) {
+        unsigned tq=tile_q.empty()?q:tile_q[b];require(tq>=1 && tq<=1024,"invalid tile q");
+        int v[768]; unsigned bx=(b%((w+15)/16))*16, by=(b/((w+15)/16))*16;
+        for(unsigned y=0;y<16;y++) for(unsigned x=0;x<16;x++) {
+            uint32_t p=rgba[size_t(std::min(by+y,h-1))*w+std::min(bx+x,w-1)];
+            int r=p&255,g=(p>>8)&255,blue=(p>>16)&255;
+            int co=r-blue,t=blue+half(co),cg=g-t;
+            v[y*16+x]=t+half(cg);v[256+y*16+x]=co;v[512+y*16+x]=cg;
+        }
+        Bits bits{f.slots.data()+size_t(b)*SLOT_WORDS,SLOT_WORDS};
+        for(unsigned c=0;c<3;c++) {
+            int* a=v+c*256; transform(a,false); bits.put(zz(a[0]),11);
+            for(unsigned i=1;i<256;i++) a[i]=(a[i]<0?-1:1)*((std::abs(a[i])+int(tq)/2)/int(tq));
+            for(unsigned base=1;base<256;base+=16) {
+                unsigned end=std::min(base+16,256u), mx=0, n=0, mask=0, nonzero=0;
+                bool same=true;
+                for(unsigned i=base;i<end;i++) { mx=std::max(mx,zz(a[i])); same &= a[i]==a[base]; if(a[i]){mask|=1u<<(i-base);nonzero++;} }
+                for(unsigned x=mx;x;x>>=1) n++;
+                bits.put(n!=0,1);
+                if(n) {
+                    unsigned mode=same?0:((16+nonzero*n<(end-base)*n)?2:1);
+                    bits.put(n,4);bits.put(mode,2);
+                    if(mode==0)bits.put(zz(a[base]),n);
+                    else {if(mode==2)bits.put(mask,16);for(unsigned i=base;i<end;i++)if(mode==1 || a[i])bits.put(zz(a[i]),n);}
+                }
+            }
+        }
+        f.lengths[b]=(bits.bit+31)/32;
+    }
+    return f;
+}
+static std::vector<uint32_t> decode_impl(const Frame& f,bool reconstruct) {
+    unsigned count=blocks(f.width,f.height);
+    require(f.q>=1 && f.q<=1024 && f.lengths.size()==count && f.slots.size()==size_t(count)*SLOT_WORDS,"invalid frame");
+    require(f.tile_q.empty() || f.tile_q.size()==count,"invalid quantizer map");
+    std::vector<uint32_t> rgba(reconstruct?size_t(f.width)*f.height:0);
+    for(unsigned b=0;b<count;b++) {
+        unsigned tq=f.tile_q.empty()?f.q:f.tile_q[b];require(tq>=1 && tq<=1024,"invalid tile q");
+        require(f.lengths[b]>=3 && f.lengths[b]<=SLOT_WORDS,"invalid tile size");
+        Bits bits{const_cast<uint32_t*>(f.slots.data()+size_t(b)*SLOT_WORDS),f.lengths[b]};
+        int v[768]={};
+        for(unsigned c=0;c<3;c++) {
+            int* a=v+c*256; a[0]=unzz(bits.get(11));
+            require((c==0 && a[0]>=0 && a[0]<=255) || (c && std::abs(a[0])<=255),"invalid DC");
+            for(unsigned base=1;base<256;base+=16) if(bits.get(1)) {
+                unsigned n=bits.get(4); require(n>=1 && n<=11,"invalid bit width");
+                unsigned mode=bits.get(2);require(mode<=2,"invalid group mode");
+                unsigned common=mode==0?bits.get(n):0,mask=mode==2?bits.get(16):0xffff;
+                require(base!=241 || !(mask&0x8000) || mode!=2,"invalid sparse mask");
+                for(unsigned i=base;i<std::min(base+16,256u);i++) {
+                    unsigned value=mode==0?common:((mask&(1u<<(i-base)))?bits.get(n):0);
+                    a[i]=unzz(value)*int(tq);
+                    require(std::abs(a[i])<=1536,"invalid AC range");
+                }
+            }
+            if(reconstruct)transform(a,true);
+        }
+        require((bits.bit+31)/32==f.lengths[b],"trailing tile data");
+        while(bits.bit<f.lengths[b]*32) require(bits.get(1)==0,"nonzero padding");
+        if(!reconstruct)continue;
+        unsigned bx=(b%((f.width+15)/16))*16, by=(b/((f.width+15)/16))*16;
+        for(unsigned y=0;y<16 && by+y<f.height;y++) for(unsigned x=0;x<16 && bx+x<f.width;x++) {
+            unsigned i=y*16+x; int t=v[i]-half(v[512+i]),g=v[512+i]+t,blue=t-half(v[256+i]),r=blue+v[256+i];
+            rgba[size_t(by+y)*f.width+bx+x]=uint32_t(std::clamp(r,0,255)) | (uint32_t(std::clamp(g,0,255))<<8) | (uint32_t(std::clamp(blue,0,255))<<16) | 0xff000000u;
+        }
+    }
+    return rgba;
+}
